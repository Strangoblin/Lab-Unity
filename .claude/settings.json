{
  "permissions": {
    "deny": [
      "Bash(git stash --all *)",
      "Bash(git stash --all)",
      "Bash(rm -rf /Users/xiaokangji/Unity/Lab/Assets/Mine/**)",
      "Bash(rm -rf ~/*)",
      "Bash(sudo *)",
      "Bash(curl * | sh)"
    ],
    "allow": [
      "Bash(unityctl *)",
      "Bash(git *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(wc *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(rm *)",
      "Bash(cd *)",
      "Bash(echo *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(sed *)",
      "Bash(python3 *)",
      "Bash(jq *)",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.mcp/bin/hooks.sh\" PreToolUse",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.mcp/bin/hooks.sh\" PostToolUse",
            "timeout": 30
          }
        ]
      }
    ]
  }
}

# macOS 文件系统杂项；共享 shell 脚本和 Metal 文档仍入库。
.DS_Store
._*
.AppleDouble/
.LSOverride
__MACOSX/

# 本机配置与认证信息 — 机器路径与凭据不入库，文件保留在本地。
/.claude/settings.local.json
/.codex/config.toml
/.codex/config.toml.bak-*
/.codex/auth.json

# 判定核运行时状态与证据账本 — 整个 state/ 都是「这台机器上发生了什么」，
# 不是仓库内容。会话状态、写入、读取、删除、移动、摩擦六本账全在这里；
# 框架级结论提炼进 memory，账本本身不入库。
/.mcp/state/
# 删除留底 — 内容和当时的样子都在，属于本机可恢复层，不入库。
/.mcp/trash/

# Codex / Unity 本地运行产物
.codex/tmp/*
!.codex/tmp/README.md
.codex/tests/*/output/
.codex/tests/*/run.log
/.unityctl/editor.log
/.unityctl/editor-prev.log
/.unityctl/bridge.json
/Screenshots/
/run.log
# 系统杂项与崩溃转储；既有 tracked 文件另按清单处理
/mono_crash*.json
/tmp/
Assets/**/.backup_*/
**/__pycache__/
*.pyc

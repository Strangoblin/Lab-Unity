# macOS 文件系统杂项；共享 shell 脚本和 Metal 文档仍入库。
.DS_Store
._*
.AppleDouble/
.LSOverride
__MACOSX/

# 本机配置与认证信息 — 机器路径与凭据不入库，文件保留在本地。
/.claude/settings.local.json
/.codex/config.toml
/.codex/config.toml.bak-*
/.codex/auth.json
/.mcp/.venv/

# 门禁运行时状态 — 进程内存 + state.json 双份, 不入库
.mcp/state.json
.mcp/state.json.tmp
# 删除审计 — 删除不留产物, 这份日志是唯一痕迹 (运行时状态, 不入库)
.mcp/deletes.jsonl
# 移动审计 — 新位置有产物, 但「哪个变成了哪个」在文件系统里查不回来, 故也落盘
.mcp/moves.jsonl
# 摩擦账本 — 门禁自观测信号（运行时状态，不入库；框架级结论提炼进 memory）
.mcp/friction.jsonl
.mcp/friction.jsonl.tmp

# Codex / Unity 本地运行产物
.codex/tmp/*
!.codex/tmp/README.md
.codex/tests/*/output/
.codex/tests/*/run.log
/.unityctl/editor.log
/.unityctl/editor-prev.log
/.unityctl/bridge.json
/Screenshots/
/run.log
# 系统杂项与崩溃转储；既有 tracked 文件另按清单处理
/mono_crash*.json
/tmp/
Assets/**/.backup_*/
**/__pycache__/
*.pyc

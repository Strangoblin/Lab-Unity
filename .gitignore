# 仓库白名单：Assets、agent 体系及根入口；其他根目录内容留在本机。
/*
!/Assets/
!/.agents/
!/.claude/
!/.codex/
!/.mcp/
!/AGENTS.md
!/.mcp.json
!/.gitignore
!/.gitattributes

# macOS 文件系统杂项；共享 shell 脚本和 Metal 文档仍入库。
.DS_Store
._*
.AppleDouble/
.LSOverride
__MACOSX/

# 本机配置与认证信息。
/.claude/settings.local.json
/.codex/config.toml
/.codex/auth.json
/.codex/config.toml.bak-*
/.mcp/.venv/

# 门禁运行时状态与审计。
/.mcp/state.json
/.mcp/state.json.tmp
/.mcp/deletes.jsonl
/.mcp/moves.jsonl

# Agent 临时产物；目录说明文档可以入库。
/.codex/tmp/*
!/.codex/tmp/README.md
/.codex/tests/*/output/
/.codex/tests/*/run.log
__pycache__/
*.pyc

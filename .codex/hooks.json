{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/xiaokangji/Unity/Lab/.mcp/bin/hooks.sh PreToolUse",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/xiaokangji/Unity/Lab/.mcp/bin/hooks.sh PostToolUse",
            "timeout": 30
          }
        ]
      }
    ]
  }
}

{
  "version": 3,
  "description": "Plain platform entries route to shared role definitions; knowledge, memory and skills are separate libraries. Architecture sources contain no symlinks.",
  "claude": {
    "retain": [
      "CLAUDE.md",
      "settings.json",
      "settings.local.json",
      "hooks/**",
      "agents/README.md",
      "skills/README.md"
    ],
    "notes": "Native discovery aliases are retired; shared roles, rules and skills are explicitly loaded through the role inventory."
  },
  "codex": {
    "retain": [
      "AGENTS.md",
      "INTERFACE.md",
      "SKILL.md",
      "config.toml",
      "config.toml.*",
      "hooks.json",
      "hooks/**",
      "tests/**",
      "tmp/**",
      "agents/README.md",
      "agents/meta-developer.toml",
      "agents/unity-developer.toml"
    ],
    "notes": "Platform runtime configuration, two thin role-route TOMLs, hooks and tests remain; shared discovery links and duplicate bodies are retired."
  },
  "shared_target": {
    "root": ".agents",
    "roles": ".agents/agents/<role>/AGENT.md",
    "rules": ".agents/knowledge/rules/",
    "references": ".agents/knowledge/<domain>/",
    "templates": ".agents/skills/<skill>/templates/",
    "cli": ".agents/skills/<skill>/references/cli/",
    "scripts": ".agents/skills/<skill>/scripts/",
    "memory": ".agents/memory/<domain>/",
    "skills": ".agents/skills/",
    "interfaces": ".agents/knowledge/meta/interfaces/"
  },
  "platform_routes": [
    ".claude/CLAUDE.md",
    ".claude/agents/README.md",
    ".codex/AGENTS.md",
    ".codex/agents/README.md"
  ]
}
